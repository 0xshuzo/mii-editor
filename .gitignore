# Local credentials for the VSCodium-to-container SSH connection.
.wii-ssh/

# Local environment settings and editor files.
.env
.env.*
!.env.example
.vscode/

# JavaScript package installs and diagnostic logs.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python's local bytecode cache (used by the dependency-free dev server).
__pycache__/
*.py[cod]

# Browser-test output and temporary visual-review captures.
playwright-report/
test-results/
mii-*.png

# Operating-system metadata.
.DS_Store
Thumbs.db
